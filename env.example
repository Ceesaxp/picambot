# picambot environment configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to /etc/picambot/env on the Pi (chmod 600, owned by the
# service user), then reference it from the systemd unit:
#
#   [Service]
#   EnvironmentFile=/etc/picambot/env
#
# For local development you can source it in your shell:
#   set -a && source env.example && set +a && go run .
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Bot token obtained from @BotFather on Telegram.
TELEGRAM_TOKEN=

# Comma-separated list of Telegram user IDs that are allowed to issue commands.
# Authorisation is checked against the *sender's* user ID (From.ID), not the
# chat ID, so it works correctly in both DMs and group chats.
#
# To find your user ID, message @userinfobot on Telegram.
ALLOWED_USER_IDS=

# ── Optional ──────────────────────────────────────────────────────────────────

# IP address that the motion webcontrol API is bound to.
# When motion is configured to listen on the Tailscale interface use the
# Tailscale IP (100.x.x.x). Defaults to 127.0.0.1 for local access.
#MOTION_HOST=127.0.0.1

# Port the motion webcontrol API listens on (motion.conf: webcontrol_port).
#MOTION_PORT=7999

# Directory where motion writes output files (motion.conf: target_dir).
# The bot watches this directory for new *.jpg and *.mp4 files during
# detection mode and forwards them to Telegram.
#MOTION_TARGET_DIR=/var/lib/motion

# Path to the JSON file used to persist FSM state across restarts.
# The parent directory is created automatically if it does not exist.
#STATE_FILE=/var/lib/picambot/state.json

# Path to the ffmpeg binary used to mux motion-produced MP4 clips with the
# matching WAV files written by arecord from motion's on_event_start hook.
# When no sibling .wav exists for a clip, the original MP4 is sent unchanged.
#FFMPEG_PATH=ffmpeg

# Log verbosity level. One of: debug, info, warn, error.
# Logs are written as JSON to stdout and captured by journald.
#LOG_LEVEL=info

# Native Apple Home switch (optional; no Homebridge required).
# On starts the camera and detection; Off stops the camera.
# Set a unique eight-digit pairing PIN; required when enabled.
#HOMEKIT_ENABLED=true
#HOMEKIT_PIN=
#HOMEKIT_NAME="Camera monitoring"
# Pairing identity and keys; defaults to homekit/ beside STATE_FILE.
# Keep this directory across restarts and deployments.
#HOMEKIT_STORAGE_DIR=/var/lib/picambot/homekit
# HomeKit listens on TCP 51826 and advertises via mDNS on the local network.
